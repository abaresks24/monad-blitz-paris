# ---- Monad Testnet ----
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# ---- Game Master (funds burners, deploys, registers players, resolves) ----
# A TEST wallet only. Fund it with MON from blitz.devnads.com.
PRIVATE_KEY=0xYOUR_TEST_PRIVATE_KEY_HERE

# Extra keeper sender keys (comma-separated, optional). If empty the keeper derives
# child keys from PRIVATE_KEY and funds them automatically.
KEEPER_KEYS=

# Deployed game contract (filled after M1 deploy)
CONTRACT_ADDRESS=

# ---- App ----
# Admin panel secret (append ?secret=... to /admin)
ADMIN_SECRET=change-me
# Public base url of the deployed app (for QR code on /screen)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143

# Optional: fund amount (in MON) sent to each burner on join
BURNER_FUND_MON=0.05

# ---- Game / keeper config ----
# Shared secret used to derive hidden roles deterministically. MUST be identical in the
# Vercel deployment (/api/join) and the laptop keeper. Keep it secret.
MASTER_SECRET=change-this-shared-secret
# ~1 controller per ROLE_DENOM players (default 8)
ROLE_DENOM=8
# Keeper defaults
N_BOTS=20
STATIONS=4
COMMIT_DURATION=12
REVEAL_DURATION=5
# GAME_ID= (leave empty to create a new game)
# 0 = wait for admin START; >0 = auto-start after N seconds
AUTOSTART_SECONDS=0

# Optional MonadScan API key for contract verification
MONADSCAN_API_KEY=
